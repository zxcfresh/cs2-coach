# === GEMINI ===
# Получи бесплатный ключ: https://aistudio.google.com/apikey
# Ключ должен начинаться с "AIza..." (39 символов)
GOOGLE_GENERATIVE_AI_API_KEY=твой_ключ_сюда

# Если ключ от прокси-шлюза (начинается НЕ с AIza) — раскомментируй и укажи адрес шлюза:
# GEMINI_BASE_URL=https://адрес-твоего-шлюза

# После изменения .env.local ОБЯЗАТЕЛЬНО перезапусти: npm run dev
